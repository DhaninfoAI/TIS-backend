# Copy to .env (gitignored). Never commit or paste real keys in chat.
PORT=4010
DEV_TOKEN=dev-token
# Postgres (Neon). Empty = local file data/state.json
DATABASE_URL=
# OpenAI: empty key = practice (mock) mode
LLM_PROVIDER=openai
OPENAI_API_KEY=
MODEL_PHOTO=gpt-4o
MODEL_REASON=gpt-4o
PHOTO_DETAIL=high
MAX_COST_PER_ANALYSIS=2.00
MOCK_DELAY_MS=250
# --- sign-in & licences
# Developer token: lets dev tools and tests in without an account. Set ALLOW_DEV_TOKEN=0 before a customer uses it.
ALLOW_DEV_TOKEN=1
# Secret that signs access tokens (any long random string). Empty = one is generated and kept in the database.
JWT_SECRET=
# Hours without use before a computer's seat is freed (it gets a seat back when used again, if one is free). 0 = never.
SEAT_IDLE_HOURS=8
# Developer previews only (harness, writer test): where the extension folder is. Not needed on a hosted server.
# EXTENSION_DIR=../extension
# First admin, created at start-up only when no admin exists yet (then remove the password from this file)
ADMIN_EMAIL=
ADMIN_PASSWORD=
